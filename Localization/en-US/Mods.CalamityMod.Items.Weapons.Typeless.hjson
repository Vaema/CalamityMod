Aestheticus: {
	DisplayName: Aestheticus
	Tooltip:
		'''
		Fires crystals that explode and slow enemies down
		This weapon scales with all your damage stats at once
		'''
}

EyeofMagnus: {
	DisplayName: Eye of Magnus
	Tooltip:
		'''
		Fires seeking cosmic masses that restore health and mana on hit
		Explodes into a nebula cloud which reduces enemy protection
		This weapon scales with the average of all your damage stats
		'''
}

LunicEye: {
	DisplayName: Lunic Eye
	Tooltip:
		'''
		Fires seeking energy bolts that reduce enemy protection
		This weapon scales with the average of all your damage stats
		'''
}

RelicOfDeliverance: {
	DisplayName: Relic of Deliverance
	Tooltip:
		'''
		Press <left> to grab hold of the spear and steer it
		Press <left> again to while flying on the spear to drift, slowing your velocity but charging an extremley fast dash released when you let go of <left>
		If you loose too much velocity before releasing the charge, you will reset to minimum speed
		Speed is halved while a boss is alive
		You can ram through enemies at the start of charged dashes
		The spear can take you through walls but will warp you to the last open space if you are inside them too long
		Holding out the spear heavily reduces the damage of all summons
		Press <right> to dismount
		'''
}

Skynamite: {
	DisplayName: Skynamite
	Tooltip:
		'''
		Throws a floaty explosive that defies gravity
		'You don't need an aerodynamics major to use this...'
		'''
}

StarStruckWater: {
	DisplayName: Star Struck Water
	Tooltip: Spreads the Astral Infection to some blocks
}

YanmeisKnife: {
	DisplayName: Yanmei's Knife
	Tooltip:
		'''
		Enemies you hit are crippled
		Hits will also give you {0}% increased movement speed and damage for {1} seconds
		'A knife from an unknown world
		An owner whose heart is pure and free of taint
		A heart of iron and valor'
		'''
}
